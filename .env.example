# Same-origin API path. Production hosts proxy /api, /uploads, and /sitemap.xml to the backend.
VITE_API_BASE_URL=/api

# Optional if the frontend and backend run on separate origins; use the real deployment URL.
# VITE_API_BASE_URL=https://api.your-domain.example/api

# Local Vite proxy target (backend origin only, no /api suffix).
VITE_DEV_API_ORIGIN=http://localhost:5000
