NODE_ENV=development
PORT=5000
# Local development listener; production deployment uses 127.0.0.1 behind Nginx.
HOST=localhost
MONGODB_URI=mongodb://127.0.0.1:27017/shenron_global
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
# Set to the built Vite dist directory when the backend should serve the site.
# FRONTEND_DIST_DIR=../dist
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD_HASH=
JWT_SECRET=
JWT_COOKIE_NAME=sg_admin_session
COOKIE_SAME_SITE=lax
UPLOAD_DIR=./uploads
# Company mailbox SMTP details. Use the provider-issued SMTP/app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# SMTP account login (often the same address as SMTP_FROM_EMAIL).
SMTP_USER=
SMTP_PASSWORD=
# Visible company sender address recipients should reply to.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Shenron Global
STORAGE_PROVIDER=local
MEDIA_BASE_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_IMAGE_SIZE=5242880
MAX_VIDEO_SIZE=52428800
